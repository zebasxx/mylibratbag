pkgname=libratbag
pkgver=0.18
pkgrel=${GITHUB_RUN_NUMBER:-1}
pkgdesc='DBus daemon and tools for configuring gaming mice'
arch=('x86_64')
url='https://github.com/libratbag/libratbag'
license=('MIT')
depends=(
  'glib2'
  'json-glib'
  'libevdev'
  'libunistring'
  'python'
  'python-evdev'
  'python-gobject'
  'systemd-libs'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'pkgconf'
  'swig'
  'systemd'
)
backup=('etc/dbus-1/system.d/org.freedesktop.ratbag1.conf')
source=("libratbag::git+file://${LIBRATBAG_SOURCE:?Set LIBRATBAG_SOURCE to the checked-out repository path}")
sha256sums=('SKIP')

pkgver() {
  cd libratbag

  local meson_version
  meson_version="$(sed -n "s/.*version[[:space:]]*:[[:space:]]*'\([^']*\)'.*/\1/p" meson.build | head -n1)"

  printf '%s.r%s.g%s' \
    "$meson_version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=12 HEAD)"
}

build() {
  arch-meson "$srcdir/libratbag" "$srcdir/build" -Dbuildtype=release -Dtests=false
  meson compile -C "$srcdir/build"
}

package() {
  meson install -C "$srcdir/build" --destdir "$pkgdir" --no-rebuild
  install -Dm644 "$srcdir/libratbag/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
